# Google AI Studio key for the research agent. Never commit the real value.
GEMINI_API_KEY=
# Model used by the agent. Falls back to GEMINI_FALLBACK_MODEL when busy.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Try Google Search grounding first (needs search quota on the key). 1 or 0.
GEMINI_SEARCH=1
PORT=4000
# Comma-separated origins allowed to call the API. * allows any.
CORS_ORIGIN=http://localhost:3000
DATABASE_PATH=data/oauth-ready.db
